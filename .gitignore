# Bazel convenience symlinks (bazel-bin, bazel-out, bazel-testlogs, bazel-<workspace>)
/bazel-*

# Bazel lock file is intentionally tracked once generated; uncomment to ignore.
# MODULE.bazel.lock

# IDE
.idea/
*.iml
.vscode/

# Lavish review artifacts
.lavish/

# Cluster runtime state and journals from scripts/run.sh (never committed)
/data/

# Local tapes: recorded for experiments (scale runs, scratch scenarios), machine-only.
# The local- prefix keeps them out of git and out of the CI journal gate.
/journal/local-*
