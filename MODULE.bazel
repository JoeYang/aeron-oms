"""aeron-oms — order management system on Aeron Cluster."""

module(
    name = "aeron_oms",
    version = "0.1.0",
)

# Java 25 is required: CPU pinning uses the FFM API (java.lang.foreign) to call
# sched_setaffinity. See .claude/rules/trading-latency.md.
bazel_dep(name = "rules_java", version = "9.1.0")
bazel_dep(name = "rules_jvm_external", version = "6.7")

JUNIT_JUPITER = "5.11.4"

JUNIT_PLATFORM = "1.11.4"

# Formatting and linting run through Bazel rather than a jar committed to the repo
# or downloaded at runtime, so every machine resolves the same version.
GOOGLE_JAVA_FORMAT = "1.36.1"

CHECKSTYLE = "13.11.0"

# SBE codec generator. Depends on agrona 2.5.0 -- the version already pinned above -- so it
# introduces no second Agrona on the path.
SBE = "1.39.0"

# Aeron Cluster. Declared as granular artifacts rather than the `aeron-all` fat jar, so each
# target states only the layer it uses; aeron-all would also bundle a second copy of Agrona.
# The dependency graph is a linear chain:
#   aeron-cluster -> aeron-archive -> aeron-driver -> aeron-client -> org.agrona:agrona
# Read maven-metadata.xml to check for newer versions. The Maven Central *search API* lags
# badly — it reported 1.48.0 as latest while 1.52.2 was current.
AERON = "1.52.2"

AGRONA = "2.5.0"

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "io.aeron:aeron-cluster:%s" % AERON,
        "io.aeron:aeron-archive:%s" % AERON,
        "io.aeron:aeron-driver:%s" % AERON,
        "io.aeron:aeron-client:%s" % AERON,
        "org.agrona:agrona:%s" % AGRONA,
        "org.junit.jupiter:junit-jupiter-api:%s" % JUNIT_JUPITER,
        "org.junit.jupiter:junit-jupiter-engine:%s" % JUNIT_JUPITER,
        "org.junit.jupiter:junit-jupiter-params:%s" % JUNIT_JUPITER,
        "org.junit.platform:junit-platform-console:%s" % JUNIT_PLATFORM,
        "org.junit.platform:junit-platform-launcher:%s" % JUNIT_PLATFORM,
        "org.junit.platform:junit-platform-reporting:%s" % JUNIT_PLATFORM,
        "com.google.googlejavaformat:google-java-format:%s" % GOOGLE_JAVA_FORMAT,
        "com.puppycrawl.tools:checkstyle:%s" % CHECKSTYLE,
        "uk.co.real-logic:sbe-tool:%s" % SBE,
    ],
    # Without this the lock SILENTLY WINS: a version changed here but not repinned is
    # ignored, the build succeeds, and the edit has no effect. Verified -- declaring agrona
    # 2.4.1 against a lock holding 2.5.0 built cleanly and used 2.5.0. Default is False.
    fail_if_repin_required = True,
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven")
