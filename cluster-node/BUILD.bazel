load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("//tools:junit5.bzl", "java_junit5_test")

# Hosts ConsensusModule + ClusteredServiceContainer. The only package permitted to depend
# on //cluster-service.
java_library(
    name = "node-lib",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        "//cluster-service",
        "//core",
        "//sbe-java",
        "@maven//:io_aeron_aeron_archive",
        "@maven//:io_aeron_aeron_client",
        "@maven//:io_aeron_aeron_cluster",
        "@maven//:io_aeron_aeron_driver",
        "@maven//:org_agrona_agrona",
    ],
)

java_binary(
    name = "cluster-node",
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    main_class = "io.joeyang.oms.cluster.node.ClusterNodeMain",
    visibility = ["//visibility:public"],
    runtime_deps = [":node-lib"],
)

# Read-only tape viewer: one line per decoded log entry, human or JSONL.
java_binary(
    name = "tape-cat",
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    main_class = "io.joeyang.oms.cluster.node.TapeCatMain",
    visibility = ["//visibility:public"],
    runtime_deps = [":node-lib"],
)

# App-mode golden-tape replayer. Lives here because this is the one package
# permitted to depend on //cluster-service.
java_binary(
    name = "tape-replay",
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    main_class = "io.joeyang.oms.cluster.node.TapeReplayMain",
    visibility = ["//visibility:public"],
    runtime_deps = [":node-lib"],
)

# Integration tests launch a real single-member cluster per test: real election, journal,
# commit and replay. size = "large" buys the timeout that lifecycle needs.
java_junit5_test(
    name = "cluster_node_test",
    size = "large",
    srcs = glob(["src/test/java/**/*.java"]),
    # The shutdown regression test runs the real binary and signals it — only a process
    # can prove the process exits. Replay tests read the committed golden tape.
    data = [
        ":cluster-node",
        "//journal:heartbeats-v1",
    ],
    test_package = "io.joeyang.oms.cluster.node",
    deps = [
        ":node-lib",
        "//cluster-service",
        "//core",
        "//sbe-java",
        "@maven//:io_aeron_aeron_client",
        "@maven//:io_aeron_aeron_cluster",
        "@maven//:org_agrona_agrona",
    ],
)
