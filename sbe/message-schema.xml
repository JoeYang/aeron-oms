<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="io.joeyang.oms.sbe"
                   id="1"
                   version="0"
                   semanticVersion="0.1"
                   description="aeron-oms message schema"
                   byteOrder="littleEndian">
  <types>
    <composite name="messageHeader" description="Template ID and length of message root.">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId"  primitiveType="uint16"/>
      <type name="schemaId"    primitiveType="uint16"/>
      <type name="version"     primitiveType="uint16"/>
    </composite>
    <type name="TimestampNanos" primitiveType="int64" description="Nanoseconds since the Unix epoch."/>
  </types>

  <sbe:message name="Heartbeat" id="1" description="Liveness probe carrying a sequenced timestamp.">
    <field name="timestampNanos" id="1" type="TimestampNanos"/>
  </sbe:message>
</sbe:messageSchema>
