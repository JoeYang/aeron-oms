<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="io.joeyang.oms.sbe"
                   id="1"
                   version="2"
                   semanticVersion="0.3"
                   description="aeron-oms message schema"
                   byteOrder="littleEndian">
  <types>
    <composite name="messageHeader" description="Template ID and length of message root.">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId"  primitiveType="uint16"/>
      <type name="schemaId"    primitiveType="uint16"/>
      <type name="version"     primitiveType="uint16"/>
    </composite>
    <type name="TimestampNanos" primitiveType="int64" minValue="0"
          description="Nanoseconds since the Unix epoch. minValue keeps the null sentinel illegal."/>
    <composite name="varDataEncoding"
               description="Variable-length bytes. uint16 length is a one-way door: ~64 KB cap.">
      <type name="length"  primitiveType="uint16" maxValue="65534"/>
      <type name="varData" primitiveType="uint8" length="0"/>
    </composite>
  </types>

  <!-- blockLength reserves 24 bytes beyond the current fields, so future appends never move
       the block length. Layout amendment decided 2026-08-22, before any journal existed. -->
  <sbe:message name="Heartbeat" id="1" blockLength="32"
               description="Liveness probe carrying a sequenced timestamp.">
    <field name="timestampNanos" id="1" type="TimestampNanos"/>
  </sbe:message>

  <!-- Appended in version 2. Same 32-byte block reserve as Heartbeat; the payload rides as
       var-length data after the block, so the block layout never depends on payload size. -->
  <sbe:message name="FatHeartbeat" id="2" blockLength="32" sinceVersion="2"
               description="Heartbeat carrying a fat deterministic payload; apply checksums it.">
    <field name="timestampNanos" id="1" type="TimestampNanos"/>
    <data name="payload" id="2" type="varDataEncoding" sinceVersion="2"/>
  </sbe:message>

  <!-- The fat echo: sequenced time plus the checksum the state machine computed over the
       payload. Egress-only; a dedicated ack keeps egress concerns out of ingress messages. -->
  <sbe:message name="FatHeartbeatAck" id="3" blockLength="32" sinceVersion="2"
               description="Echo for FatHeartbeat: sequenced timestamp and payload checksum.">
    <field name="timestampNanos" id="1" type="TimestampNanos"/>
    <field name="payloadChecksum" id="2" type="int64"/>
  </sbe:message>
</sbe:messageSchema>
