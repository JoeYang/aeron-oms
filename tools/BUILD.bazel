load("@rules_java//java:defs.bzl", "java_binary")

# Build tooling. The junit5.bzl macro is loaded by test targets across all packages.

exports_files(["junit5.bzl"])

# google-java-format reaches into javac internals, which are not exported by default
# on a modern JDK. Without these flags it fails at runtime with IllegalAccessError.
GJF_JVM_FLAGS = [
    "--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED",
    "--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED",
    "--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED",
    "--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED",
    "--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED",
    "--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED",
    "--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED",
]

java_binary(
    name = "google-java-format",
    jvm_flags = GJF_JVM_FLAGS,
    main_class = "com.google.googlejavaformat.java.Main",
    visibility = ["//visibility:public"],
    runtime_deps = ["@maven//:com_google_googlejavaformat_google_java_format"],
)

# google_checks.xml defaults every rule to `warning` severity, and Checkstyle exits zero
# when only warnings are present. Left alone, the lint gate reports success while printing
# violations. Promoting to `error` is what makes it an actual gate.
java_binary(
    name = "checkstyle",
    jvm_flags = ["-Dorg.checkstyle.google.severity=error"],
    main_class = "com.puppycrawl.tools.checkstyle.Main",
    visibility = ["//visibility:public"],
    runtime_deps = ["@maven//:com_puppycrawl_tools_checkstyle"],
)
